# IMS Atlas — Caddy fragment for aiserv-server (vpn-server).
# Source of truth for production: cesar-andress/aiserv-server caddy/Caddyfile.
# Docs: deploy/README-access.md
#
# Prompt 4: Authelia for everything except a minimal public whitelist
# (landing, metodologia, privacidad, aviso-legal, robots, favicon, og, assets).

# --- whoami (authenticate, then synthesize JSON from forward_auth headers) ---
handle /datos-cerrados/whoami.json {
	forward_auth 10.204.0.3:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
	header Cache-Control "private, no-store"
	header X-Robots-Tag "noindex, nofollow"
	header Content-Type application/json
	respond `{"user":"{http.request.header.Remote-User}","name":"{http.request.header.Remote-Name}","groups":["{http.request.header.Remote-Groups}"],"email":"{http.request.header.Remote-Email}"}`
}

# --- Public marketing (no session) ---
@atlas_public {
	path /
	path /metodologia
	path /privacidad
	path /aviso-legal
	path /robots.txt
	path /favicon.ico
	path /favicon.svg
	path /og-landing.svg
	path /assets/*
}

handle @atlas_public {
	reverse_proxy 10.204.0.3:8121 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# --- Everything else (app + data + status + cerrada) behind Authelia ---
handle {
	forward_auth 10.204.0.3:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
	header Cache-Control "private, no-store"
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 10.204.0.3:8121 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Atlas-Auth-User {http.request.header.Remote-User}
		header_up X-Atlas-Auth-Name {http.request.header.Remote-Name}
		header_up X-Atlas-Auth-Groups {http.request.header.Remote-Groups}
	}
}
