[Unit]
Description=Weekly IMS Atlas full pipeline (after freshness check)
After=ims-atlas-check.timer

[Timer]
# Sunday 04:30 UTC — check timer is weekly with random delay; pipeline follows.
OnCalendar=Sun *-*-* 04:30:00
Persistent=true
RandomizedDelaySec=30m
Unit=ims-atlas-pipeline.service

[Install]
WantedBy=timers.target
