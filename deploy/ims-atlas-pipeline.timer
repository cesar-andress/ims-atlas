[Unit]
Description=Hourly IMS Atlas pipeline tick (R-0)
After=ims-atlas-check.timer

[Timer]
# Every hour, Europe/Madrid. flock in atlas-etl-pipeline.sh skips overlap.
OnCalendar=hourly
Timezone=Europe/Madrid
Persistent=true
RandomizedDelaySec=3m
Unit=ims-atlas-pipeline.service

[Install]
WantedBy=timers.target
