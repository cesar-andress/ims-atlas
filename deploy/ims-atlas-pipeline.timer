[Unit]
Description=Daily IMS Atlas full pipeline (after freshness check)
After=ims-atlas-check.timer

[Timer]
# Daily 03:00 Europe/Madrid (EXTRA-5 / EXTRA-10).
OnCalendar=*-*-* 03:00:00
Timezone=Europe/Madrid
Persistent=true
RandomizedDelaySec=15m
Unit=ims-atlas-pipeline.service

[Install]
WantedBy=timers.target
