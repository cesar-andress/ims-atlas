[Unit]
Description=Daily IMS Atlas full pipeline (R-0 + release-dual + promote)
After=ims-atlas-pipeline.timer

[Timer]
# Embed TZ in the calendar expression. Host timedatectl is Etc/UTC and bare
# Timezone= on .timer is ignored here (systemd shows next_elapse in UTC).
# 03:30 Europe/Madrid → winter 02:30 UTC / summer 01:30 UTC.
OnCalendar=*-*-* 03:30:00 Europe/Madrid
Persistent=true
RandomizedDelaySec=3m
Unit=ims-atlas-daily.service

[Install]
WantedBy=timers.target
