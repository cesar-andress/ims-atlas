# Copy to /opt/services/authelia/authelia.env (never commit the live file).
# Each value is a filesystem path readable inside the Authelia container.

AUTHELIA_SESSION_SECRET_FILE=/secrets/session.secret
AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/secrets/storage.encryption_key

# Production SMTP (optional — remove or leave unset when using filesystem notifier)
# AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE=/secrets/notifier.smtp.password

# JWT / OIDC extras if enabled later (uncomment when needed)
# AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/secrets/reset.jwt.secret
# AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET_FILE=/secrets/oidc.hmac.secret