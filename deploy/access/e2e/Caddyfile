{
	admin off
}

auth.atlas.e2e.local {
	tls internal
	reverse_proxy authelia:9091
}

atlas.e2e.local {
	tls internal

	handle /datos-cerrados/whoami.json {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth?authelia_url=https://auth.atlas.e2e.local/
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		header Cache-Control "private, no-store"
		respond `{"username":"{http.request.header.Remote-User}","groups":"{http.request.header.Remote-Groups}","email":"{http.request.header.Remote-Email}"}` {
			header Content-Type application/json
		}
	}

	@cerrado path /datos-cerrados/*
	handle @cerrado {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth?authelia_url=https://auth.atlas.e2e.local/
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		header Cache-Control "private, no-store"
		reverse_proxy nginx-cerrada:80
	}

	respond "IMS Atlas access e2e — open /datos-cerrados/manifest.json" 200
}