{
	admin off
}

auth.atlas.e2e.local {
	tls internal
	reverse_proxy authelia:9091
}

atlas.e2e.local {
	tls internal

	handle /datos-cerrados/whoami.json {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth?authelia_url=https://auth.atlas.e2e.local/
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		header Cache-Control "private, no-store"
		respond `{"user":"{http.request.header.Remote-User}","name":"{http.request.header.Remote-Name}","groups":"{http.request.header.Remote-Groups}","email":"{http.request.header.Remote-Email}"}` {
			header Content-Type application/json
		}
	}

	@atlas_public {
		path /
		path /metodologia
		path /privacidad
		path /aviso-legal
		path /robots.txt
		path /favicon.ico
		path /favicon.svg
		path /og-landing.svg
		path /assets/*
	}

	handle @atlas_public {
		reverse_proxy nginx-cerrada:80
	}

	handle {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth?authelia_url=https://auth.atlas.e2e.local/
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		header Cache-Control "private, no-store"
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy nginx-cerrada:80
	}
}
