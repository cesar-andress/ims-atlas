{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.aiserv.es/catalog/sources.schema.json",
  "title": "IMS Atlas source registry",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "yesNoUnknown": { "type": "string", "enum": ["yes", "no", "unknown"] },
    "rights": {
      "type": "object",
      "required": [
        "licence_id",
        "use_research",
        "redistribute_raw",
        "redistribute_derived",
        "commercial_use",
        "attribution_required",
        "share_alike",
        "no_derivatives",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "licence_id": { "type": "string", "minLength": 1 },
        "use_research": { "$ref": "#/$defs/yesNoUnknown" },
        "redistribute_raw": { "$ref": "#/$defs/yesNoUnknown" },
        "redistribute_derived": { "$ref": "#/$defs/yesNoUnknown" },
        "commercial_use": { "$ref": "#/$defs/yesNoUnknown" },
        "attribution_required": { "$ref": "#/$defs/yesNoUnknown" },
        "share_alike": { "$ref": "#/$defs/yesNoUnknown" },
        "no_derivatives": { "$ref": "#/$defs/yesNoUnknown" },
        "evidence": {
          "type": "object",
          "required": ["terms_url"],
          "additionalProperties": false,
          "properties": {
            "checked_by": { "type": ["string", "null"] },
            "checked_on": { "type": ["string", "null"] },
            "terms_url": { "type": "string", "minLength": 1 },
            "snapshot_sha256": { "type": ["string", "null"] },
            "note": { "type": "string" }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "publisher",
        "landing_url",
        "terms_url",
        "licence_url",
        "endpoints",
        "update_cadence",
        "version_detection",
        "citation",
        "rights"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "publisher": { "type": "string", "minLength": 1 },
        "landing_url": { "type": "string", "minLength": 1 },
        "terms_url": { "type": "string", "minLength": 1 },
        "licence_url": { "type": "string", "minLength": 1 },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "template"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "template": { "type": "string", "minLength": 1 },
              "method": { "type": "string", "enum": ["GET", "POST"], "default": "GET" },
              "notes": { "type": "string" }
            }
          }
        },
        "update_cadence": {
          "type": "string",
          "enum": ["annual", "biennial", "quarterly", "irregular", "static"]
        },
        "version_detection": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "rights": { "$ref": "#/$defs/rights" }
      }
    }
  }
}
